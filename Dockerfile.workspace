FROM ubuntu:22.04

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bison \
        byacc \
        flex \
        build-essential \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

CMD ["tail", "-f", "/dev/null"]
